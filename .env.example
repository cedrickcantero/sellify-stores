# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (main branch) used by the app, migrations and the seed.
DATABASE_URL="postgresql://user:password@ep-example-123456.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# A separate Neon branch for integration tests. Must differ from DATABASE_URL:
# the tests truncate tables between runs.
TEST_DATABASE_URL="postgresql://user:password@ep-example-test-654321.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Vercel Blob read/write token for logo and product image uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_example_token"

# Host that serves the backend, and the root domain whose subdomains serve stores.
APP_HOST="localhost:3000"
STORE_ROOT_DOMAIN="stores.example.com"

# Optional, local only: route the Neon driver through `pnpm db:local-proxy` to a
# plain local Postgres. Leave unset everywhere else.
# NEON_LOCAL_WS_PROXY="localhost:5488"
